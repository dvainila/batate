        <mxCell id="cli-badge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Команда установки (100% offline):&lt;/b&gt;&lt;br&gt;&lt;code&gt;node tools/installer/bmad-cli.js install \&lt;br&gt;  --directory /path/to/my-project \&lt;br&gt;  --modules bmm --tools cursor \&lt;br&gt;  --no-shims --yes&lt;/code&gt;" vertex="1">
          <mxGeometry height="85" width="310" x="935" y="90" as="geometry" />
        </mxCell>
        <mxCell id="l-tools" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;├── tools/installer/&lt;/b&gt;&lt;br&gt;│   ├── &lt;b&gt;bmad-cli.js&lt;/b&gt; + core/installer.js (Installer) + manifest-generator.js&lt;br&gt;│   ├── &lt;b&gt;project-root.js&lt;/b&gt; (берёт src/ с диска) + core/shim-policy.js&lt;br&gt;│   └── &lt;b&gt;ide/platform-codes.yaml&lt;/b&gt; + ide/_config-driven.js (cursor → .agents/skills)" vertex="1">
          <mxGeometry height="90" width="490" x="80" y="195" as="geometry" />
