<mxfile host="Electron">
  <diagram name="Local Install Mapping (Two Trees)" id="local-install-mapping-03">
    <mxGraphModel dx="1858" dy="1118" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;Локальная установка BMAD из репозитория в пустой проект (без сети)&lt;/b&gt; — два дерева и 3 этапа переноса/сборки" vertex="1">
          <mxGeometry height="30" width="1200" x="60" y="15" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Легенда:&lt;/b&gt;   &lt;font color=&quot;#9673a6&quot;&gt;━━&lt;/font&gt; слияние / генерация конфигов    |    &lt;font color=&quot;#6c8ebf&quot;&gt;━━&lt;/font&gt; копирование / плоский деплой скиллов    |    &lt;font color=&quot;#82b366&quot;&gt;━━&lt;/font&gt; генерация индексов и манифестов    |    &lt;font color=&quot;#888888&quot;&gt;- - -&lt;/font&gt; пропускается при --no-shims" vertex="1">
          <mxGeometry height="24" width="1350" x="60" y="48" as="geometry" />
        </mxCell>
        <mxCell id="band-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#faf7fc;strokeColor=#d8cce6;strokeWidth=1;fontSize=12;" value="&lt;b&gt;ЭТАП 1. Запуск CLI, сбор ответов и генерация конфигов&lt;/b&gt; — &lt;code&gt;Installer.install() → ModuleManager.collectAllConfigurations() → ManifestGenerator.writeCentralConfig()&lt;/code&gt;" vertex="1">
          <mxGeometry height="405" width="2120" x="40" y="155" as="geometry" />
        </mxCell>
        <mxCell id="band-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f8fd;strokeColor=#c9daf8;strokeWidth=1;fontSize=12;" value="&lt;b&gt;ЭТАП 2. Копирование runtime-скриптов и плоский деплой скиллов/агентов в IDE&lt;/b&gt; — &lt;code&gt;_installSharedScripts() → _installOfficialModules() → _setupIdes() → _cleanupSkillDirs()&lt;/code&gt;" vertex="1">
          <mxGeometry height="535" width="2120" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="band-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5faf5;strokeColor=#c8e0c2;strokeWidth=1;fontSize=12;" value="&lt;b&gt;ЭТАП 3. Слияние help-таблиц и генерация манифестов (_bmad/_config/)&lt;/b&gt; — &lt;code&gt;ManifestGenerator.generateManifests() + Installer.mergeModuleHelpCatalogs()&lt;/code&gt;" vertex="1">
          <mxGeometry height="430" width="2120" x="40" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="left-root" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=13;" value="&lt;b&gt;📁 BMAD-METHOD-6.12.4/&lt;/b&gt; (оригинальный репозиторий)" vertex="1">
          <mxGeometry height="42" width="840" x="60" y="95" as="geometry" />
        </mxCell>
        <mxCell id="right-root" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;" value="&lt;b&gt;📁 my-project/&lt;/b&gt; (пустой проект после установки, по образцу clean_bmad_v6 без bmb)" vertex="1">
          <mxGeometry height="42" width="860" x="1280" y="95" as="geometry" />
