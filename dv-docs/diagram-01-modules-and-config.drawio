        </mxCell>
        <mxCell id="runtime-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Runtime (вызов у пользователя)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="320" x="1030" y="280" as="geometry" />
        </mxCell>
        <mxCell id="party-mode" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Вызов bmad-party-mode&lt;/b&gt;&lt;hr&gt;1. Запускает &lt;code&gt;resolve_party.py&lt;/code&gt;&lt;br&gt;2. Вызывает &lt;code&gt;_bmad/scripts/resolve_config.py&lt;/code&gt;&lt;br&gt;3. Читает таблицы &lt;b&gt;[agents.*]&lt;/b&gt; из собранного &lt;code&gt;_bmad/config.toml&lt;/code&gt; (+ оверрайды)&lt;br&gt;4. Берёт оттуда &lt;b&gt;краткое описание агентов&lt;/b&gt;, чтобы собрать команду / комнату без чтения каждого скилла." vertex="1">
          <mxGeometry height="145" width="330" x="1030" y="555" as="geometry" />
        </mxCell>
        <mxCell id="edge-toml-to-party" edge="1" parent="1" source="bmad-config-toml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeWidth=2;strokeColor=#9673a6;fontSize=10;" target="party-mode" value="берёт [agents.*]">
          <mxGeometry relative="1" x="0.2308" y="17" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="agent-runtime-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Вызов отдельного агента (напр. Mary)&lt;/b&gt;&lt;hr&gt;Скилл лежит в &lt;code&gt;.agents/skills/bmad-agent-analyst/&lt;/code&gt;.&lt;br&gt;Детальное поведение (principles, persistent_facts, [[agent.menu]]) берётся через &lt;code&gt;resolve_customization.py&lt;/code&gt; из &lt;code&gt;customize.toml&lt;/code&gt; + &lt;code&gt;_bmad/custom/bmad-agent-analyst.toml&lt;/code&gt;." vertex="1">
          <mxGeometry height="125" width="330" x="1030" y="725" as="geometry" />
