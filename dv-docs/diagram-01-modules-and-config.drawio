        <mxCell id="mod-yaml-agents" parent="mod-yaml" style="text;strokeColor=#6c8ebf;fillColor=#e6f0ff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;3. agents: (краткие описания / эссенция)&lt;/b&gt;&lt;br&gt;Список: code, name, title, icon, team, description&lt;br&gt;• bmad-agent-analyst (Mary)&lt;br&gt;• bmad-agent-pm (John)&lt;br&gt;• bmad-agent-ux-designer (Sally)&lt;br&gt;• bmad-agent-architect (Winston)&lt;br&gt;• bmad-agent-dev (Amelia)" vertex="1">
          <mxGeometry height="160" width="330" y="230" as="geometry" />
