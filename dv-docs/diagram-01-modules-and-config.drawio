        <mxCell id="edge-agents-to-toml" edge="1" parent="1" source="mod-yaml-agents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.75;fontSize=10;" target="bmad-config-toml" value="collectAgentsFromModuleYaml()">
