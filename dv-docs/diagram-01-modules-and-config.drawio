        <mxCell id="meta-target" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Выбор модуля при установке&lt;/b&gt;&lt;br&gt;Задаёт ключ секции &lt;code&gt;[modules.bmm]&lt;/code&gt; и выбор по умолчанию в пикере." vertex="1">
          <mxGeometry height="65" width="260" x="430" y="485" as="geometry" />
        </mxCell>
        <mxCell id="installer-questions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Установщик (tools/installer/)&lt;/b&gt;&lt;br&gt;&lt;code&gt;core/config.js&lt;/code&gt; превращает &lt;code&gt;prompt:&lt;/code&gt; в вопросы пользователю при &lt;code&gt;bmad install&lt;/code&gt; (или флаги &lt;code&gt;--set bmm.*&lt;/code&gt;)." vertex="1">
          <mxGeometry height="100" width="260" x="430" y="575" as="geometry" />
        </mxCell>
        <mxCell id="bmad-config-toml" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;{project-root}/_bmad/config.toml&lt;/b&gt;&lt;br&gt;&lt;i&gt;(собирается при установке: manifest-generator.js)&lt;/i&gt;&lt;hr&gt;&lt;b&gt;[core]&lt;/b&gt; — project_name, output_folder&lt;br&gt;&lt;b&gt;[modules.bmm]&lt;/b&gt; — пути артефактов&lt;br&gt;&lt;b&gt;[agents.bmad-agent-analyst]&lt;/b&gt;&lt;br&gt;&lt;b&gt;[agents.bmad-agent-pm]&lt;/b&gt; ...&lt;br&gt;&lt;i&gt;(таблицы с описаниями агентов)&lt;/i&gt;&lt;hr&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ _bmad/config.user.toml (личные поля с scope: user)&lt;/span&gt;" vertex="1">
          <mxGeometry height="235" width="240" x="730" y="575" as="geometry" />
        </mxCell>
