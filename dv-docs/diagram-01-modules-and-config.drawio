        <mxCell id="mod-yaml-meta" parent="mod-yaml" style="text;strokeColor=#6c8ebf;fillColor=#ffffff;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;1. Module metadata&lt;/b&gt;&lt;br&gt;• code: bmm&lt;br&gt;• name: &quot;BMad Method&quot;&lt;br&gt;• description, default_selected: true" vertex="1">
