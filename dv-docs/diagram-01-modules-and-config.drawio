        <mxCell id="mod-yaml-questions" parent="mod-yaml" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" value="&lt;b&gt;2. Install questions (prompt:)&lt;/b&gt;&lt;br&gt;• user_skill_level &lt;i&gt;(scope: user)&lt;/i&gt;&lt;br&gt;• planning_artifacts &lt;i&gt;(default: {output_folder}/planning-artifacts)&lt;/i&gt;&lt;br&gt;• implementation_artifacts&lt;br&gt;• project_knowledge &lt;i&gt;(default: docs)&lt;/i&gt;" vertex="1">
