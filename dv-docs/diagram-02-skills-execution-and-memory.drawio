  <diagram name="Skill execution and memory" id="skill-exec-memory-01">
    <mxGraphModel dx="9012" dy="4798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Уровень 3: Работа скиллов и агентов от слэш-команды до результата&lt;/b&gt; (четыре типа раскладок и связи со слоем памяти)" vertex="1">
          <mxGeometry height="32" width="1100" x="100" y="10" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" value="&lt;b&gt;Легенда шин и стрелок:&lt;/b&gt;   &lt;font color=&quot;#7B1FA2&quot;&gt;&lt;b&gt;━━ конфиги&lt;/b&gt;&lt;/font&gt;    |    &lt;font color=&quot;#1B8A3D&quot;&gt;&lt;b&gt;━━ память сессии&lt;/b&gt;&lt;/font&gt;    |    &lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;━━ артефакты и код&lt;/b&gt;&lt;/font&gt;    |    сплошная = пишет/обновляет,  пунктир = читает/проверяет" vertex="1">
          <mxGeometry height="24" width="1150" x="100" y="44" as="geometry" />
        </mxCell>
        <mxCell id="mem-frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fillColor=#f9f9f9;strokeColor=#444444;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Слой памяти, конфигов и артефактов (общее хранилище проекта)&lt;/b&gt;" vertex="1">
          <mxGeometry height="235" width="2420" x="100" y="85" as="geometry" />
        </mxCell>
        <mxCell id="mem-config" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Конфиги + статическая память&lt;/b&gt;&lt;hr&gt;• {project-root}/_bmad/config.toml + config.user.toml&lt;br&gt;  (user_name, languages, planning_artifacts, implementation_artifacts, [agents.*])&lt;br&gt;• {skill-root}/customize.toml + _bmad/custom/&lt;skill&gt;.toml (+ .user.toml)&lt;br&gt;  (persistent_facts, activation_steps_*, principles, [[agent.menu]], on_complete)&lt;br&gt;• {project-root}/AGENTS.md (managed block от bmad-project-context)" vertex="1">
          <mxGeometry height="175" width="680" x="120" y="125" as="geometry" />
        </mxCell>
        <mxCell id="mem-session" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;Оперативная память сессии&lt;/b&gt;&lt;hr&gt;• {doc_workspace}/.memlog.md через _bmad/scripts/memlog.py&lt;br&gt;  (init / append / set; resume читает файл напрямую)&lt;br&gt;• Frontmatter выходных документов:&lt;br&gt;  stepsCompleted[], status (draft/final), inputDocuments[]&lt;br&gt;• Rendered snapshot workflow.md (только для bmad-build)&lt;br&gt;• Контекст персоны агента в чате (иконка, стиль, принципы, persistent_facts)" vertex="1">
          <mxGeometry height="175" width="680" x="960" y="125" as="geometry" />
        </mxCell>
        <mxCell id="mem-art" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;Артефакты и код проекта&lt;/b&gt;&lt;hr&gt;• {planning_artifacts}/ — *prd*.md, *architecture*.md, ux-designs/, epics.md&lt;br&gt;• {output_folder}/brainstorming/&lt;slug&gt;/ — .memlog.md, brainstorm.html, intent.md&lt;br&gt;• {implementation_artifacts}/sprint-status.yaml + spec files&lt;br&gt;• {project-root} исходный код + git commit | {project_knowledge} (docs/)" vertex="1">
          <mxGeometry height="175" width="680" x="1800" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c1-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;1. bmad-create-epics-and-stories&lt;/b&gt;&lt;br&gt;Пошаговый скилл: steps/ + templates/ + HALT-меню" vertex="1">
          <mxGeometry height="50" width="460" x="120" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c1-trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Вызов:&lt;/b&gt; /bmad-create-epics-and-stories  или  «create the epics and stories list»" vertex="1">
          <mxGeometry height="45" width="460" x="120" y="565" as="geometry" />
        </mxCell>
        <mxCell id="c1-skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;src/bmm-skills/plan/bmad-create-epics-and-stories/SKILL.md&lt;/b&gt;&lt;br&gt;Читает только 1 текущий шаг (Just-In-Time Loading). Не грузит будущие шаги заранее. Обязательный HALT перед каждым меню." vertex="1">
          <mxGeometry height="70" width="460" x="120" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c1-act" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;On Activation&lt;/b&gt;&lt;br&gt;1. uv run {project-root}/_bmad/scripts/resolve_customization.py --skill {skill-root} --key workflow&lt;br&gt;2. Выполняет {workflow.activation_steps_prepend} и загружает persistent_facts (в т.ч. file: globs)&lt;br&gt;3. uv run {project-root}/_bmad/scripts/resolve_config.py → приветствие и пути&lt;br&gt;4. Выполняет {workflow.activation_steps_append}" vertex="1">
          <mxGeometry height="115" width="460" x="120" y="730" as="geometry" />
        </mxCell>
        <mxCell id="c1-s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;./steps/step-01-validate-prerequisites.md&lt;/b&gt;&lt;br&gt;Ищет и проверяет PRD, Architecture и UX в {planning_artifacts}.&lt;br&gt;Создаёт {planning_artifacts}/epics.md из ./templates/epics-template.md,&lt;br&gt;записывает inputDocuments[] и stepsCompleted[] в frontmatter. HALT [C]." vertex="1">
          <mxGeometry height="95" width="460" x="120" y="870" as="geometry" />
        </mxCell>
        <mxCell id="c1-s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;./steps/step-02-design-epics.md → ./steps/step-03-create-stories.md&lt;/b&gt;&lt;br&gt;Последовательно (append-only) формирует эпики и user stories с AC&lt;br&gt;в {planning_artifacts}/epics.md. Обновляет stepsCompleted[]. HALT [C]." vertex="1">
          <mxGeometry height="90" width="460" x="120" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c1-s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;./steps/step-04-final-validation.md&lt;/b&gt;&lt;br&gt;Проверяет 100% покрытие FR, отсутствие forward-зависимостей и file churn.&lt;br&gt;При успехе и выборе [C] меняет status: draft → final в epics.md." vertex="1">
          <mxGeometry height="80" width="460" x="120" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="c1-end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Финал&lt;/b&gt;&lt;br&gt;Вызывает другой скилл: Invoke the &lt;code&gt;bmad-help&lt;/code&gt; skill (подскажет следующий этап).&lt;br&gt;Запускает resolve_customization.py --key workflow.on_complete и исполняет хук." vertex="1">
          <mxGeometry height="85" width="460" x="120" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="e-c1-1" edge="1" parent="1" source="c1-trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-skill" />
        <mxCell id="e-c1-2" edge="1" parent="1" source="c1-skill" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-act" />
        <mxCell id="e-c1-3" edge="1" parent="1" source="c1-act" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-s1" />
        <mxCell id="e-c1-4" edge="1" parent="1" source="c1-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-s2" />
        <mxCell id="e-c1-5" edge="1" parent="1" source="c1-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-s4" />
        <mxCell id="e-c1-6" edge="1" parent="1" source="c1-s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;" target="c1-end" />
        <mxCell id="c2-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;2. bmad-brainstorming&lt;/b&gt;&lt;br&gt;Скилл с scripts/ + assets/*.csv + references/ + memlog" vertex="1">
          <mxGeometry height="50" width="460" x="760" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c2-trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Вызов:&lt;/b&gt; /bmad-brainstorming  или  «help me brainstorm»" vertex="1">
          <mxGeometry height="45" width="460" x="760" y="565" as="geometry" />
        </mxCell>
        <mxCell id="c2-skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;src/core-skills/bmad-brainstorming/SKILL.md&lt;/b&gt;&lt;br&gt;On Activation: resolve_customization.py (--key workflow), persistent_facts,&lt;br&gt;resolve_config.py (--key core), затем проверяет режим (interactive / headless)." vertex="1">
          <mxGeometry height="70" width="460" x="760" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c2-resume" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Resume-проверка незавершённых сессий&lt;/b&gt;&lt;br&gt;Делает Glob {workflow.output_dir}/*/.memlog.md и читает frontmatter.&lt;br&gt;Если есть сессия со status != complete → грузит ./references/resume.md.&lt;br&gt;Иначе спрашивает тему/цель и биндит {doc_workspace}." vertex="1">
          <mxGeometry height="115" width="460" x="760" y="730" as="geometry" />
        </mxCell>
        <mxCell id="c2-assets" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;./assets/ + ./scripts/brain.py&lt;/b&gt;&lt;br&gt;Читает ./assets/brain-methods.csv и ./assets/brain-icons.json.&lt;br&gt;Запускает uv run {skill-root}/scripts/brain.py → генерит ./assets/brain-selector.html.&lt;br&gt;Пользователь выбирает техники в браузере и вставляет промпт." vertex="1">
          <mxGeometry height="95" width="460" x="760" y="870" as="geometry" />
        </mxCell>
        <mxCell id="c2-mem" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;{project-root}/_bmad/scripts/memlog.py&lt;/b&gt;&lt;br&gt;init --workspace {doc_workspace} --field topic/goal/mode.&lt;br&gt;В ходе диалога пишет каждую идею/инсайт/решение: append --type ...&lt;br&gt;Файл: {output_folder}/brainstorming/&lt;slug&gt;/.memlog.md." vertex="1">
          <mxGeometry height="90" width="460" x="760" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c2-refs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;./references/ (подгружаются по ситуации)&lt;/b&gt;&lt;br&gt;mode-facilitator.md / mode-partner.md / mode-autonomous.md.&lt;br&gt;Когда идеи исчерпаны → ./references/converge.md → ./references/finalize.md." vertex="1">
          <mxGeometry height="80" width="460" x="760" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="c2-end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Финал (./references/finalize.md)&lt;/b&gt;&lt;br&gt;Субагенты читают .memlog.md и создают brainstorm.html + brainstorm-intent.md.&lt;br&gt;memlog.py set status=complete | external_handoffs | Invoke bmad-help | опц. bmad-customize / bmad-spec." vertex="1">
          <mxGeometry height="85" width="460" x="760" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="e-c2-1" edge="1" parent="1" source="c2-trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-skill" />
        <mxCell id="e-c2-2" edge="1" parent="1" source="c2-skill" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-resume" />
        <mxCell id="e-c2-3" edge="1" parent="1" source="c2-resume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-assets" />
        <mxCell id="e-c2-4" edge="1" parent="1" source="c2-assets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-mem" />
        <mxCell id="e-c2-5" edge="1" parent="1" source="c2-mem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-refs" />
        <mxCell id="e-c2-6" edge="1" parent="1" source="c2-refs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#82b366;" target="c2-end" />
        <mxCell id="c3-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" value="&lt;b&gt;3. bmad-build&lt;/b&gt;&lt;br&gt;Rendered-скилл: render_skill.py + плоские step-NN.md" vertex="1">
          <mxGeometry height="50" width="460" x="1400" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c3-trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Вызов:&lt;/b&gt; /bmad-build  или  делегирование фичи / story / бага" vertex="1">
          <mxGeometry height="45" width="460" x="1400" y="565" as="geometry" />
        </mxCell>
        <mxCell id="c3-skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;src/bmm-skills/ship/bmad-build/SKILL.md&lt;/b&gt;&lt;br&gt;Минимальный entrypoint: запускает uv run --no-cache {project-root}/_bmad/scripts/render_skill.py.&lt;br&gt;При ошибке HALT — исходные step-файлы напрямую читать запрещено." vertex="1">
          <mxGeometry height="70" width="460" x="1400" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c3-render" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;_bmad/scripts/render_skill.py (compile-time сборка)&lt;/b&gt;&lt;br&gt;Собирает все .md скилла (кроме SKILL.md), подставляет {{config.key}}, {{.key}},&lt;br&gt;{workflow.key} и разворачивает [[bmad-snapshot:file.md]].&lt;br&gt;Печатает абсолютный путь к compiled ./workflow.md, откуда агент стартует." vertex="1">
          <mxGeometry height="115" width="460" x="1400" y="730" as="geometry" />
        </mxCell>
        <mxCell id="c3-steps" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;Плоские шаги в корне скилла (из снапшота)&lt;/b&gt;&lt;br&gt;./step-01-clarify-and-route.md → ./step-02-plan.md (spec-template.md)&lt;br&gt;→ ./step-03-implement.md (пишет код и тесты)&lt;br&gt;→ ./step-04-review.md + ./review-prompts/* + ./references/claims-check.md" vertex="1">
          <mxGeometry height="95" width="460" x="1400" y="870" as="geometry" />
        </mxCell>
        <mxCell id="c3-s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;./step-05-present.md&lt;/b&gt;&lt;br&gt;Ставит status: done в {spec_file}. Если есть story_key — вызывает&lt;br&gt;[[bmad-snapshot:sync-sprint-status.md]] → обновляет {implementation_artifacts}/sprint-status.yaml.&lt;br&gt;Делает локальный conventional git commit (без push)." vertex="1">
          <mxGeometry height="90" width="460" x="1400" y="990" as="geometry" />
        </mxCell>
        <mxCell id="c3-end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="&lt;b&gt;Финал&lt;/b&gt;&lt;br&gt;Предлагает создать PR / Invoke the &lt;code&gt;bmad-walkthrough&lt;/code&gt; skill / ещё изменение.&lt;br&gt;Выполняет {workflow.on_complete}." vertex="1">
          <mxGeometry height="80" width="460" x="1400" y="1105" as="geometry" />
        </mxCell>
        <mxCell id="e-c3-1" edge="1" parent="1" source="c3-trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;" target="c3-skill" />
        <mxCell id="e-c3-2" edge="1" parent="1" source="c3-skill" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;" target="c3-render" />
        <mxCell id="e-c3-3" edge="1" parent="1" source="c3-render" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;" target="c3-steps" />
        <mxCell id="e-c3-4" edge="1" parent="1" source="c3-steps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;" target="c3-s5" />
        <mxCell id="e-c3-5" edge="1" parent="1" source="c3-s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;" target="c3-end" />
        <mxCell id="c4-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" value="&lt;b&gt;4. bmad-agent-architect (Winston)&lt;/b&gt;&lt;br&gt;Агент-персона: [agent] + меню + делегирование скиллов" vertex="1">
          <mxGeometry height="50" width="460" x="2040" y="490" as="geometry" />
        </mxCell>
        <mxCell id="c4-trigger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Вызов:&lt;/b&gt; /bmad-agent-architect  или  «talk to Winston» / «request architect»" vertex="1">
          <mxGeometry height="45" width="460" x="2040" y="565" as="geometry" />
        </mxCell>
        <mxCell id="c4-skill" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;src/bmm-skills/agents/bmad-agent-architect/SKILL.md&lt;/b&gt;&lt;br&gt;Устанавливается как обычный скилл в .agents/skills/bmad-agent-architect/.&lt;br&gt;Включает режим постоянной персоны до явного выхода пользователя." vertex="1">
          <mxGeometry height="70" width="460" x="2040" y="635" as="geometry" />
        </mxCell>
        <mxCell id="c4-act" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Steps 1–4: Персона и контекст&lt;/b&gt;&lt;br&gt;1. resolve_customization.py --skill {skill-root} --key agent&lt;br&gt;   (customize.toml + _bmad/custom/bmad-agent-architect.toml + .user.toml)&lt;br&gt;2. Выполняет {agent.activation_steps_prepend}&lt;br&gt;3. Принимает персону Winston (role, identity, communication_style, principles)&lt;br&gt;4. Загружает {agent.persistent_facts} (строки + file: globs)" vertex="1">
