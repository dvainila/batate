        <mxCell id="band3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5faf5;strokeColor=#c8e0c2;strokeWidth=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="600" width="2540" x="40" y="1385" as="geometry" />
