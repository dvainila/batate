        <mxCell id="e-l1-bmm-scripts" edge="1" parent="1" source="l1-bmm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#1565C0;fontColor=#1565C0;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#1565C0;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="l1-scripts" value="uv run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l1-core-scripts" edge="1" parent="1" source="l1-core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#1565C0;fontColor=#1565C0;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#1565C0;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="l1-scripts" value="uv run">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="545" />
              <mxPoint x="2190" y="545" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="div1" parent="1" style="line;strokeWidth=2;dashed=1;strokeColor=#999999;html=1;" value="" vertex="1">
          <mxGeometry height="10" width="2540" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="band2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f5f8fd;strokeColor=#c9daf8;strokeWidth=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="720" width="2540" x="40" y="630" as="geometry" />
        </mxCell>
        <mxCell id="l2-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;УРОВЕНЬ 2. Модуль, скилл, YAML / CSV и два контура TOML&lt;/b&gt;  —  &lt;b&gt;За что отвечает:&lt;/b&gt; устройство модуля и скилла в src/.  &lt;b&gt;Что показывает:&lt;/b&gt; как module.yaml, module-help.csv и customize.toml превращаются в рабочие конфиги и индексы через resolve_config.py и resolve_customization.py." vertex="1">
          <mxGeometry height="54" width="2460" x="80" y="646" as="geometry" />
        </mxCell>
        <mxCell id="l2-yaml" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;module.yaml&lt;/b&gt; [в репо, не копируется в .agents/skills/]&lt;hr&gt;Есть в &lt;code&gt;core-skills/&lt;/code&gt;, &lt;code&gt;bmm-skills/&lt;/code&gt; и внешних модулях.&lt;br&gt;• &lt;code&gt;code, name, directories: [&quot;{output_folder}&quot;]&lt;/code&gt;&lt;br&gt;• &lt;code&gt;prompt:&lt;/code&gt; вопросы при install (пути артефактов, язык, уровень)&lt;br&gt;• &lt;code&gt;agents:&lt;/code&gt; (в bmm) краткий &lt;b&gt;essence roster&lt;/b&gt; 5 агентов&lt;br&gt;  (полная персона живёт в &lt;code&gt;agents/*/customize.toml&lt;/code&gt;)&lt;br&gt;Читают: &lt;code&gt;official-modules.js&lt;/code&gt;, &lt;code&gt;manifest-generator.js&lt;/code&gt;, &lt;code&gt;list-options.js&lt;/code&gt;." vertex="1">
          <mxGeometry height="235" width="560" x="80" y="760" as="geometry" />
        </mxCell>
        <mxCell id="l2-helpcsv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;module-help.csv&lt;/b&gt; [в репо, по одному на модуль]&lt;hr&gt;13 колонок: &lt;code&gt;module, skill, display-name, menu-code, description, action, args, phase, preceded-by, followed-by, required, output-location, outputs&lt;/code&gt;.&lt;br&gt;Склейка при install: &lt;code&gt;Installer.mergeModuleHelpCatalogs()&lt;/code&gt; + &lt;code&gt;module-help-schema.js&lt;/code&gt;." vertex="1">
          <mxGeometry height="150" width="560" x="80" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="l2-skillmd" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;SKILL.md&lt;/b&gt; (обязательный) [в репо]&lt;hr&gt;YAML frontmatter (&lt;code&gt;name, description&lt;/code&gt;) + &lt;code&gt;On Activation&lt;/code&gt; + шаги." vertex="1">
          <mxGeometry height="90" width="560" x="820" y="760" as="geometry" />
        </mxCell>
        <mxCell id="l2-cust" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;customize.toml&lt;/b&gt; [в репо, DO NOT EDIT]&lt;hr&gt;Дефолты &lt;code&gt;[workflow]&lt;/code&gt; или &lt;code&gt;[agent]&lt;/code&gt;: &lt;code&gt;principles&lt;/code&gt;, &lt;code&gt;persistent_facts&lt;/code&gt;, &lt;code&gt;[[agent.menu]]&lt;/code&gt;.&lt;br&gt;Перезаписывается при update." vertex="1">
          <mxGeometry height="100" width="560" x="820" y="870" as="geometry" />
        </mxCell>
        <mxCell id="l2-body" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Тело скилла + локальные scripts/&lt;/b&gt; [в репо]&lt;hr&gt;Раскладки: single-file / плоские &lt;code&gt;step-NN.md&lt;/code&gt; / &lt;code&gt;steps/step-NN.md&lt;/code&gt; + &lt;code&gt;references/&lt;/code&gt;.&lt;br&gt;&lt;code&gt;scripts/&lt;/code&gt;: &lt;code&gt;resolve_party.py&lt;/code&gt;, &lt;code&gt;list_customizable_skills.py&lt;/code&gt;, &lt;code&gt;brain.py&lt;/code&gt;, &lt;code&gt;pick_methods.py&lt;/code&gt;." vertex="1">
          <mxGeometry height="110" width="560" x="820" y="990" as="geometry" />
        </mxCell>
        <mxCell id="l2-assets" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;assets/*.csv&lt;/b&gt; [в репо, локальные каталоги скилла]&lt;hr&gt;&lt;code&gt;bmad-brainstorming/assets/brain-methods.csv&lt;/code&gt; ← &lt;code&gt;brain_methods&lt;/code&gt; + &lt;code&gt;brain.py&lt;/code&gt;;&lt;br&gt;&lt;code&gt;bmad-advanced-elicitation/assets/methods.csv&lt;/code&gt; ← &lt;code&gt;methods_file&lt;/code&gt; + &lt;code&gt;pick_methods.py&lt;/code&gt;." vertex="1">
          <mxGeometry height="90" width="560" x="820" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="l2-ca" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Контур A — resolve_config.py&lt;/b&gt; + config_utils.py [после install]&lt;hr&gt;Мерджит 4 слоя настроек проекта и пользователя:&lt;br&gt;1. &lt;code&gt;_bmad/config.toml&lt;/code&gt; → 2. &lt;code&gt;config.user.toml&lt;/code&gt; → 3. &lt;code&gt;_bmad/custom/config.toml&lt;/code&gt; → 4. &lt;code&gt;custom/config.user.toml&lt;/code&gt;.&lt;br&gt;Хранит &lt;code&gt;[core]&lt;/code&gt;, &lt;code&gt;[modules.*]&lt;/code&gt;, &lt;code&gt;[agents.*]&lt;/code&gt; (их читает &lt;code&gt;resolve_party.py&lt;/code&gt;)." vertex="1">
          <mxGeometry height="150" width="880" x="1660" y="760" as="geometry" />
        </mxCell>
        <mxCell id="l2-cb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Контур B — resolve_customization.py&lt;/b&gt; + config_utils.py&lt;hr&gt;Мерджит 3 слоя поведения конкретного скилла или агента:&lt;br&gt;1. &lt;code&gt;{skill-root}/customize.toml&lt;/code&gt; [в репо] → 2. &lt;code&gt;_bmad/custom/{skill}.toml&lt;/code&gt; → 3. &lt;code&gt;{skill}.user.toml&lt;/code&gt;.&lt;br&gt;Вызывается из &lt;code&gt;SKILL.md&lt;/code&gt; при &lt;code&gt;On Activation&lt;/code&gt;." vertex="1">
          <mxGeometry height="130" width="880" x="1660" y="930" as="geometry" />
        </mxCell>
        <mxCell id="l2-idx" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;_bmad/_config/&lt;/b&gt; [после install]&lt;hr&gt;• &lt;code&gt;bmad-help.csv&lt;/code&gt; — склейка всех &lt;code&gt;module-help.csv&lt;/code&gt;&lt;br&gt;• &lt;code&gt;skill-manifest.csv&lt;/code&gt; — из &lt;code&gt;ManifestGenerator&lt;/code&gt;; читают &lt;code&gt;installer.js&lt;/code&gt;, &lt;code&gt;shim-policy.js&lt;/code&gt;, &lt;code&gt;ide/_config-driven.js&lt;/code&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="1660" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="l2-merge" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;structural_merge&lt;/b&gt; (config_utils.py)&lt;hr&gt;Скаляры override; таблицы deep-merge; массивы append; &lt;code&gt;[[agent.menu]]&lt;/code&gt; по &lt;code&gt;code/id&lt;/code&gt; replace-or-append. Оверрайды sparse." vertex="1">
          <mxGeometry height="130" width="430" x="2110" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="l2-help" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;bmad-help/SKILL.md&lt;/b&gt; читает собранный &lt;code&gt;bmad-help.csv&lt;/code&gt;." vertex="1">
          <mxGeometry height="50" width="430" x="1660" y="1255" as="geometry" />
        </mxCell>
        <mxCell id="e-l2-yaml-ca" edge="1" parent="1" source="l2-yaml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="l2-ca" value="prompt: + collectAgentsFromModuleYaml() → _bmad/config.toml">
