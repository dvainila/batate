        <mxCell id="l3-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;УРОВЕНЬ 3. Кастомизация и 4 хранилища информации&lt;/b&gt;  —  &lt;b&gt;За что отвечает:&lt;/b&gt; где хранить свои правки и где лежат данные BMAD.  &lt;b&gt;Что показывает:&lt;/b&gt; файлы _bmad/custom/ слева и 4 файловых хранилища проекта (единой БД нет) справа." vertex="1">
          <mxGeometry height="54" width="2460" x="80" y="1401" as="geometry" />
        </mxCell>
        <mxCell id="l3-rule" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Правило update&lt;/b&gt;&lt;hr&gt;&lt;code&gt;{skill-root}/customize.toml&lt;/code&gt; и &lt;code&gt;_bmad/config.toml&lt;/code&gt; перезаписываются при update. Свои правки — только в &lt;code&gt;_bmad/custom/&lt;/code&gt; [создаётся при install, не затирается]." vertex="1">
          <mxGeometry height="70" width="1080" x="80" y="1480" as="geometry" />
        </mxCell>
        <mxCell id="l3-scope" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;Команда vs личное&lt;/b&gt;&lt;hr&gt;&lt;code&gt;&amp;lt;name&amp;gt;.toml&lt;/code&gt; — командные, в git.&lt;br&gt;&lt;code&gt;&amp;lt;name&amp;gt;.user.toml&lt;/code&gt; — личные, в &lt;code&gt;.gitignore&lt;/code&gt;." vertex="1">
          <mxGeometry height="110" width="520" x="80" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="l3-facts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Что кастомизируется&lt;/b&gt;&lt;hr&gt;&lt;code&gt;persistent_facts&lt;/code&gt; (строки и &lt;code&gt;file:&lt;/code&gt; glob), &lt;code&gt;principles&lt;/code&gt;, &lt;code&gt;activation_steps_prepend/append&lt;/code&gt;, &lt;code&gt;[[agent.menu]]&lt;/code&gt;, пути и язык." vertex="1">
          <mxGeometry height="115" width="520" x="80" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="l3-tool" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;bmad-customize&lt;/b&gt; (src/core-skills/bmad-customize/)&lt;hr&gt;Использует &lt;code&gt;scripts/list_customizable_skills.py&lt;/code&gt;.&lt;br&gt;Пишет per-skill &lt;code&gt;[agent]&lt;/code&gt; / &lt;code&gt;[workflow]&lt;/code&gt; оверрайды в &lt;code&gt;_bmad/custom/{skill}.toml&lt;/code&gt;." vertex="1">
          <mxGeometry height="110" width="520" x="640" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="l3-manual" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;Ручная правка&lt;/b&gt;&lt;hr&gt;Центральный &lt;code&gt;_bmad/custom/config.toml&lt;/code&gt; не пишет &lt;code&gt;bmad-customize&lt;/code&gt; — правится вручную (пути, &lt;code&gt;[agents.*]&lt;/code&gt;)." vertex="1">
          <mxGeometry height="115" width="520" x="640" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="stores-frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f9f9f9;strokeColor=#444444;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Файловые хранилища проекта&lt;/b&gt;" vertex="1">
          <mxGeometry height="480" width="1210" x="1320" y="1481" as="geometry" />
        </mxCell>
        <mxCell id="store1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;1. Статическая память&lt;/b&gt;&lt;hr&gt;&lt;code&gt;customize.toml&lt;/code&gt; [в репо] + &lt;code&gt;_bmad/custom/*&lt;/code&gt; + &lt;code&gt;_bmad/config*.toml&lt;/code&gt; [после install]. Правила и &lt;code&gt;persistent_facts&lt;/code&gt; при каждой активации." vertex="1">
          <mxGeometry height="90" width="1080" x="1360" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="l3-memlog" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;memlog.py&lt;/b&gt;&lt;hr&gt;&lt;code&gt;src/scripts/&lt;/code&gt;&lt;br&gt;&lt;code&gt;init / append&lt;/code&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="1360" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="store2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;2. Оперативная память прогона&lt;/b&gt;&lt;hr&gt;&lt;code&gt;{doc_workspace}/.memlog.md&lt;/code&gt; [появится при работе скилла]. Append-only (&lt;code&gt;decision, constraint&lt;/code&gt;), переживает сжатие контекста." vertex="1">
          <mxGeometry height="110" width="380" x="1650" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="store3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="&lt;b&gt;3. Память party-mode&lt;/b&gt;&lt;hr&gt;&lt;code&gt;{output_folder}/party-mode/memories/&amp;lt;id&amp;gt;/.memlog.md&lt;/code&gt; [появится при party-mode]." vertex="1">
          <mxGeometry height="110" width="380" x="2060" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="store4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;4. Долговременная память проекта&lt;/b&gt; [появятся лениво]&lt;hr&gt;&lt;code&gt;{output_folder}&lt;/code&gt; [создаётся при install]. &lt;code&gt;planning_artifacts/&lt;/code&gt;, &lt;code&gt;implementation_artifacts/&lt;/code&gt;, &lt;code&gt;project_knowledge&lt;/code&gt; (&lt;code&gt;docs/&lt;/code&gt;), код + managed-блок &lt;code&gt;AGENTS.md&lt;/code&gt; (&lt;code&gt;bmad-project-context&lt;/code&gt;)." vertex="1">
          <mxGeometry height="115" width="1080" x="1360" y="1820" as="geometry" />
        </mxCell>
