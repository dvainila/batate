        <mxCell id="e-l2-skill-ca" edge="1" parent="1" source="l2-skillmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;dashed=1;exitX=1;exitY=0.4;entryX=0;entryY=0.25;" target="l2-ca" value="читает JSON (On Activation)">
