        <mxCell id="e-l2-cust-cb" edge="1" parent="1" source="l2-cust" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" target="l2-cb" value="слой 1 (дефолты)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1570" y="920" />
              <mxPoint x="1570" y="1021" />
            </Array>
