        <mxCell id="e-l1-bmm-cli" edge="1" parent="1" source="l1-bmm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;dashed=1;exitX=0.5;exitY=0;entryX=0.35;entryY=0;" target="l1-cli" value="читает bmm module.yaml + help.csv">
          <mxGeometry relative="1" as="geometry">
