<mxfile host="Electron">
  <diagram name="BMAD source architecture" id="source-architecture-01-1">
    <mxGraphModel dx="3037" dy="1827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2640" pageHeight="2020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" value="&lt;b&gt;Архитектура BMAD-METHOD до установки&lt;/b&gt; — что где лежит, YAML / CSV / TOML, кастомизация и хранилища" vertex="1">
          <mxGeometry height="30" width="2100" x="40" y="14" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Легенда:&lt;/b&gt;   &lt;font color=&quot;#7B1FA2&quot;&gt;&lt;b&gt;━━ конфиги / YAML / TOML&lt;/b&gt;&lt;/font&gt;    |    &lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;━━ каталоги CSV / артефакты / скрипты&lt;/b&gt;&lt;/font&gt;    |    &lt;font color=&quot;#1B8A3D&quot;&gt;&lt;b&gt;━━ память сессии&lt;/b&gt;&lt;/font&gt;    |    сплошная = пишет / мерджит / создаёт    |    пунктир = читает / вызывает    |    &lt;code&gt;[в репо]&lt;/code&gt; vs &lt;code&gt;[после install]&lt;/code&gt;" vertex="1">
          <mxGeometry height="24" width="2460" x="40" y="46" as="geometry" />
        </mxCell>
        <mxCell id="band1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#faf7fc;strokeColor=#d8cce6;strokeWidth=1;fontSize=12;" value="" vertex="1">
          <mxGeometry height="515" width="2540" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="l1-header" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" value="&lt;b&gt;УРОВЕНЬ 1. Карта BMAD в покое (BMAD-METHOD-6.12.4/)&lt;/b&gt;  —  &lt;b&gt;За что отвечает:&lt;/b&gt; показывает только папки репозитория, участвующие в работе BMAD.  &lt;b&gt;Что показывает:&lt;/b&gt; где лежат установщик, модули, скиллы и Python-движок и кто к кому обращается." vertex="1">
          <mxGeometry height="54" width="2460" x="80" y="96" as="geometry" />
        </mxCell>
        <mxCell id="l1-cli" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;tools/installer/bmad-cli.js&lt;/b&gt;&lt;hr&gt;Точка входа &lt;code&gt;bin.bmad&lt;/code&gt; из &lt;code&gt;package.json&lt;/code&gt;.&lt;br&gt;Разворачивает модули и &lt;code&gt;src/scripts/&lt;/code&gt; в проект,&lt;br&gt;собирает &lt;code&gt;_bmad/config.toml&lt;/code&gt;." vertex="1">
          <mxGeometry height="105" width="460" x="100" y="230" as="geometry" />
        </mxCell>
        <mxCell id="l1-modyaml-reg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="&lt;b&gt;bmad-modules.yaml&lt;/b&gt; [в репо]&lt;hr&gt;Реестр внешних модулей: &lt;code&gt;bmb, cis, tea, bmad-loop, gds&lt;/code&gt;.&lt;br&gt;В &lt;code&gt;src/&lt;/code&gt; их нет — клонируются при install по URL и &lt;code&gt;module-definition&lt;/code&gt;.&lt;br&gt;Читают: &lt;code&gt;external-manager.js&lt;/code&gt;, &lt;code&gt;channel-plan.js&lt;/code&gt;." vertex="1">
          <mxGeometry height="105" width="460" x="100" y="385" as="geometry" />
        </mxCell>
        <mxCell id="l1-core" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" value="&lt;b&gt;src/core-skills/&lt;/b&gt; (code: core) [в репо]&lt;hr&gt;• &lt;code&gt;module.yaml&lt;/code&gt; + &lt;code&gt;module-help.csv&lt;/code&gt;&lt;br&gt;• &lt;code&gt;bmad-help&lt;/code&gt;, &lt;code&gt;bmad-customize&lt;/code&gt;, &lt;code&gt;bmad-party-mode&lt;/code&gt;&lt;br&gt;• &lt;code&gt;bmad-brainstorming&lt;/code&gt;, &lt;code&gt;bmad-advanced-elicitation&lt;/code&gt;&lt;br&gt;• &lt;code&gt;bmad-review&lt;/code&gt;, &lt;code&gt;bmad-deep-recon&lt;/code&gt;, &lt;code&gt;bmad-forge-idea&lt;/code&gt;" vertex="1">
          <mxGeometry height="260" width="460" x="720" y="230" as="geometry" />
        </mxCell>
        <mxCell id="l1-bmm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;src/bmm-skills/&lt;/b&gt; (code: bmm) [в репо]&lt;hr&gt;• &lt;code&gt;module.yaml&lt;/code&gt; + &lt;code&gt;module-help.csv&lt;/code&gt;&lt;br&gt;• &lt;code&gt;agents/&lt;/code&gt; — 5 персон (analyst, pm, ux, architect, dev)&lt;br&gt;• &lt;code&gt;plan/&lt;/code&gt; — brief, prd, ux, arch, spec, epics, sprint-planning&lt;br&gt;• &lt;code&gt;ship/&lt;/code&gt; — build, build-auto, code-review, qa, retro" vertex="1">
          <mxGeometry height="260" width="460" x="1340" y="230" as="geometry" />
        </mxCell>
        <mxCell id="l1-scripts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="&lt;b&gt;src/scripts/&lt;/b&gt; (не модуль, Python 3.11+) [в репо]&lt;hr&gt;• &lt;code&gt;resolve_config.py&lt;/code&gt;, &lt;code&gt;resolve_customization.py&lt;/code&gt;&lt;br&gt;• &lt;code&gt;config_utils.py&lt;/code&gt; (&lt;code&gt;structural_merge&lt;/code&gt;)&lt;br&gt;• &lt;code&gt;render_skill.py&lt;/code&gt;, &lt;code&gt;memlog.py&lt;/code&gt;&lt;br&gt;Скиллы вызывают через &lt;code&gt;uv run&lt;/code&gt; (после install → &lt;code&gt;_bmad/scripts/&lt;/code&gt;)." vertex="1">
          <mxGeometry height="260" width="460" x="1960" y="230" as="geometry" />
        </mxCell>
        <mxCell id="e-l1-reg-cli" edge="1" parent="1" source="l1-modyaml-reg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="l1-cli" value="внешние модули">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-l1-core-cli" edge="1" parent="1" source="l1-core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2.5;strokeColor=#7B1FA2;fontColor=#7B1FA2;fontStyle=1;labelBackgroundColor=#ffffff;labelBorderColor=#7B1FA2;fontSize=10;dashed=1;exitX=0.25;exitY=0;entryX=0.72;entryY=0;" target="l1-cli" value="читает core module.yaml + help.csv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="202" />
              <mxPoint x="431" y="202" />
            </Array>
          </mxGeometry>
